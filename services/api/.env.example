# Copy this file to services/api/.env and fill in your keys. Never commit .env.

# Google search via SerpAPI (https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=

# Groq LLM API (https://console.groq.com/keys)
GROQ_API_KEY=
# openai/gpt-oss-20b (default, free tier) or openai/gpt-oss-120b (larger)
GROQ_MODEL=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low

# "groq" (default) or "mock" (offline fake LLM, for tests / dry runs)
LLM_PROVIDER=groq

# Optional
# FACT_VALIDATOR_DEBUG_LOG=1
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# FACT_VALIDATOR_DB=
# FACT_VALIDATOR_DATA_DIR=
